MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
MONGO_CONNECT_RETRIES=8
MONGO_CONNECT_TIMEOUT_MS=15000
PORT=6000

# Required in production. In development, defaults to "dev-secret".
JWT_SECRET=change-me

# Set to true to enable OpenAPI response validation.
OPENAPI_VALIDATE_RESPONSES=false

# OpenAI (LangChain provider)
OPENAI_API_KEY=

# xAI (OpenAI-compatible) (LangChain provider)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Weather providers
# Open-Meteo: free tier typically needs no key. If you have a key, set OPEN_METEO_API_KEY.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=

# NASA POWER: no key needed.
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/hourly/point

# MOSDAC: varies by access method. If you have a JSON endpoint, set MOSDAC_JSON_URL.
# If it requires auth, set MOSDAC_API_KEY (+ optional MOSDAC_API_KEY_HEADER).
MOSDAC_JSON_URL=
MOSDAC_API_KEY=
MOSDAC_API_KEY_HEADER=Authorization

# Seeding helper
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Admin
SEED_ADMIN_ROLE=admin
