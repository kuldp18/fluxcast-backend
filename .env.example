MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
MONGO_CONNECT_RETRIES=8
MONGO_CONNECT_TIMEOUT_MS=15000
PORT=6000

# Required in production. In development, defaults to "dev-secret".
JWT_SECRET=change-me

# Set to true to enable OpenAPI response validation.
OPENAPI_VALIDATE_RESPONSES=false

# OpenAI (LangChain provider)
OPENAI_API_KEY=

# xAI (OpenAI-compatible) (LangChain provider)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Optional MOSDAC integration hook
MOSDAC_JSON_URL=

# Seeding helper
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Admin
SEED_ADMIN_ROLE=admin
